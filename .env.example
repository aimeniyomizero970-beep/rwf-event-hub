# =============================================================================
# EMBS / RWF Event Hub — environment variables
# Copy to `.env` (local) or set in your host's dashboard. NEVER commit secrets.
# Server-side vars (no VITE_ prefix) stay private. VITE_ vars are exposed to the
# browser, so only put non-secret values there.
# =============================================================================

# --- App -------------------------------------------------------------------
# Public base URL of the deployed app (used for payment callbacks/webhooks).
APP_URL=http://localhost:5173
# Random 32+ char string used to sign session cookies. `openssl rand -hex 32`.
SESSION_SECRET=change_me_to_a_long_random_string

# --- Database + Auth (Supabase) -------------------------------------------
# Create a project at https://supabase.com/dashboard (free tier).
# Settings > API gives the URL and keys. SQL schema lives in supabase/schema.sql.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Postgres connection string, only needed for running migrations/seed scripts.
DATABASE_URL=postgresql://postgres:password@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- Payments --------------------------------------------------------------
# Which provider to charge with: "paystack" | "flutterwave" | "mtn-momo" | "manual".
# "manual" keeps the current instructions-only behaviour (no live charging).
PAYMENT_PROVIDER=manual

# Paystack (Stripe-owned; best Africa coverage). https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Flutterwave (fallback). https://dashboard.flutterwave.com/settings/apis
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
VITE_FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=

# MTN MoMo (direct). https://momodeveloper.mtn.com/
MTN_MOMO_API_URL=
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_KEY=
MTN_MOMO_USER_ID=
MTN_MOMO_TARGET_ENV=sandbox
MTN_MOMO_CALLBACK_URL=

# --- Event discovery feed (Ticketmaster, free) -----------------------------
# https://developer-account.ticketmaster.com/ (free, 5000 calls/day).
TICKETMASTER_API_KEY=

# --- Live streaming (Mux) --------------------------------------------------
# https://dashboard.mux.com/settings/access-tokens
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# --- Manual bank/MoMo details shown when PAYMENT_PROVIDER=manual -----------
BANK_NAME=BK
BANK_ACCOUNT=100258706767
MOMO_ACCOUNT=1256231
MOMO_PHONE=0798528250
VITE_BANK_NAME=BK
VITE_BANK_ACCOUNT=100258706767
VITE_MOMO_ACCOUNT=1256231
VITE_MOMO_PHONE=0798528250
