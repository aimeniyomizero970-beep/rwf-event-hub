# Stripe Payment Configuration
# Get keys from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Application URLs
VITE_API_URL=http://localhost:5173
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# Server URLs for webhooks
API_URL=http://localhost:5173

# MTN MoMo / Airtel Money Integration (Optional)
# Store these ONLY in local .env, NEVER commit to GitHub
# Get from your Stripe Dashboard after connecting your mobile money account
VITE_MTN_ENABLED=false
VITE_AIRTEL_ENABLED=false

# Mobile Money Provider Configuration
# These values should ONLY be stored in .env.local (not committed)
# Do NOT hardcode phone numbers or payment codes in source files
MTN_API_KEY=your_mtn_api_key_here
MTN_API_USER=your_mtn_api_user_here
MTN_SUBSCRIPTION_KEY=your_mtn_subscription_key_here

AIRTEL_API_KEY=your_airtel_api_key_here
AIRTEL_API_USER=your_airtel_api_user_here

# SECURITY REMINDER:
# - Never commit real API keys to GitHub
# - Never hardcode phone numbers or payment codes
# - Use .env.local for sensitive local development
# - All real payment credentials should be managed through Stripe Dashboard
